{
  "name": "ghost-town",
  "private": true,
  "version": "1.0.0",
  "description": "A walkable 3D recreation of downtown Bushnell, Illinois, around 1880.",
  "type": "module",
  "scripts": {
    "data": "python3 scripts/build-town-data.py",
    "dev": "vite --host 0.0.0.0 --port 4179 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4179 --strictPort",
    "check": "node scripts/check-town.mjs",
    "compare": "node scripts/compare-facade.mjs",
    "pages:build": "vite build --base=/ && wrangler pages functions build --outfile=dist/_worker.js",
    "pages:dev": "vite build --base=/ && wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "vite": "^6.0.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
